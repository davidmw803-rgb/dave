# Copy to .env (gitignored). Read from the environment only; never logged.
UW_API_KEY=
UW_API_BASE_URL=https://api.unusualwhales.com
# SEC requires a declared User-Agent with contact info.
SEC_USER_AGENT="strategy-loop research you@example.com"
ANTHROPIC_API_KEY=
# claude_code (default) | api
LLM_BACKEND=claude_code
# Where DuckDB + parquet live. Defaults to ./data
LOOP_DATA_DIR=
# Push alerts: any URL that accepts a JSON POST, e.g. https://ntfy.sh/<your-private-topic>
LOOP_ALERT_WEBHOOK=
# Sharadar via Nasdaq Data Link: daily prices + point-in-time universe (`loop vendor sync`)
NASDAQ_DATA_LINK_API_KEY=
