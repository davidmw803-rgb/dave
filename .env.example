# ============================================================================
# App password gate
# The password is normally set IN THE APP: the first visit to /login asks you to
# choose one, and it is stored scrypt-hashed in the app_settings table. Change
# it later on /settings. Nothing to configure here.
#
# APP_PASSWORD is an optional override for anyone who prefers config over
# database — when no password is stored, this one is accepted.
# ============================================================================
APP_PASSWORD=

# Optional: key used to sign session cookies. Defaults to
# SUPABASE_SERVICE_ROLE_KEY, which every deployment already has. Rotating
# whichever is in use signs everyone out.
APP_SESSION_SECRET=

# Optional: encryption key for API keys saved through /settings. Defaults to a
# key derived from SUPABASE_SERVICE_ROLE_KEY, so it only matters if you want the
# stored secrets to survive a service-role key rotation.
SETTINGS_SECRET=

# ============================================================================
# Supabase
# Used by the Polymarket paper-trade dashboard (/, /trades, /markets/[slug], /strategy).
# - NEXT_PUBLIC_* keys are safe to expose to the browser (Realtime + client reads).
# - SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY — never import into client code.
#   Consumed by /api/live-mids and server components (lib/supabase/admin.ts).
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key-from-supabase-start
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-from-supabase-start
# Production Supabase project (used by /live-trades dashboard via the anon key + RLS):
#   NEXT_PUBLIC_SUPABASE_URL=https://shwylcfhxmrunwjbunnf.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from Supabase project settings>


# ============================================================================
# Unusual Whales API
# Get key from https://unusualwhales.com/api
# ============================================================================
# Both of these can also be set on /settings in the app, which takes precedence.
UW_API_KEY=
UW_API_BASE_URL=https://api.unusualwhales.com

# ============================================================================
# TipRanks API
# Feeds the analyst-consensus half of /stocks/analysis.
# Server-only — never prefix with NEXT_PUBLIC_.
# ============================================================================
# Both of these can also be set on /settings in the app, which takes precedence.
TIPRANKS_API_KEY=
TIPRANKS_API_BASE_URL=https://api.tipranks.com

# ============================================================================
# Price provider (Session 5+)
# Set PRICE_PROVIDER to: mock | polygon | databento
# ============================================================================
PRICE_PROVIDER=mock
POLYGON_API_KEY=
DATABENTO_API_KEY=

# ============================================================================
# Anthropic (for narratives + weekly reports, Session 6+)
# ============================================================================
ANTHROPIC_API_KEY=

# ============================================================================
# App
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
